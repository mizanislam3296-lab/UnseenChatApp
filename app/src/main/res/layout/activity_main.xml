<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:orientation="vertical">

    <!-- উপরের হেডার বার ও থিম বাটন -->
    <LinearLayout
        android:id="@+id/headerMainBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#00A884"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Unseen Chat"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ডার্ক ও ডে মোড বাটন -->
        <TextView
            android:id="@+id/btnMainThemeToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#00796B"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="🌓 থিম"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- প্ল্যাটফর্ম ট্যাব বার (WhatsApp, Messenger, Telegram) -->
    <LinearLayout
        android:id="@+id/tabContainerBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#00A884"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabWhatsApp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:gravity="center"
            android:text="WhatsApp"
            android:textColor="#00A884"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMessenger"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Messenger"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabTelegram"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Telegram"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- চ্যাট লিস্ট ও এম্পটি স্টেট -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="এখনো কোনো মেসেজ আসেনি"
            android:textColor="#757575"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
