<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEAE2">

    <!-- হেডার বার -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#00A884"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- AI অটো রিপ্লাই সুইচ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- কাস্টম অফলাইন মেসেজ বাটন -->
        <Button
            android:id="@+id/btnOfflineSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#00897B"
            android:text="💬 অফলাইন"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- মেসেজ লিস্ট -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/layoutSuggestions"
        app:layout_constraintTop_toBottomOf="@id/headerBar" />

    <!-- ম্যানুয়াল AI সাজেশন বাটন বার -->
    <HorizontalScrollView
        android:id="@+id/layoutSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E0E0E0"
        android:padding="6dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutInputBar">

        <LinearLayout
            android:id="@+id/containerSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- মেসেজ ইনপুট বার -->
    <LinearLayout
        android:id="@+id/layoutInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnAiGenerate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#00A884"
            android:text="✨ AI"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp" />

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Type a message..."
            android:maxLines="4"
            android:padding="8dp"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#00A884" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
